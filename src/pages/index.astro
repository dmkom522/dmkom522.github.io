---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0, 3);
---
<BaseLayout>
	<section class="hero shell">
		<div class="hero-copy">
			<p class="eyebrow">AI · Computer Vision · Research</p>
			<h1 class="display">在真实问题中，<br />学习如何思考。</h1>
			<p class="lead">你好，我是 Yi Zhou，一名正在打磨数学、计算机科学与人工智能基础的本科生。这里记录我的项目、实验和逐渐成形的研究兴趣。</p>
			<div class="actions"><a class="primary" href="/projects/">查看项目 <span aria-hidden="true">↗</span></a><a class="secondary" href="/about/">了解更多</a></div>
		</div>
		<div class="portrait-wrap">
			<img src="/images/yi-zhou-avatar.png" width="1254" height="1254" alt="Yi Zhou 的插画头像" />
			<div class="portrait-note"><span></span> Currently learning in public</div>
		</div>
	</section>
	<section class="section shell">
		<div class="section-head"><div><p class="eyebrow">Selected work</p><h2 class="section-title">项目与实践</h2></div><a class="text-link" href="/projects/">全部项目</a></div>
		{projects.length ? <div class="card-grid">{projects.slice(0, 2).map((project) => <article class="card"><div class="meta"><span>{project.status}</span></div><h3>{project.title}</h3><p>{project.description}</p></article>)}</div> : <div class="empty-state">项目卡片已经预留。第一个适合放进来的内容，可以是带有问题定义、实验过程和结果的计算机视觉项目。</div>}
	</section>
	<section class="section shell">
		<div class="section-head"><div><p class="eyebrow">Recent notes</p><h2 class="section-title">最近文章</h2></div><a class="text-link" href="/writing/">全部文章</a></div>
		<div class="card-grid">
			{posts.map((post) => <article class="card"><div class="meta"><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('zh-CN')}</time><span>{post.data.tags.join(' · ')}</span></div><h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}
		</div>
	</section>
	<section class="principle shell"><p class="eyebrow">Working principle</p><p>保持长期方向稳定，在真实项目里提高能力，并根据新证据不断修正具体路线。</p></section>
</BaseLayout>
<style>
	.hero { min-height: 690px; padding: 86px 0 94px; display: grid; grid-template-columns: 1.35fr .65fr; align-items: center; gap: clamp(40px, 7vw, 100px); }
	.hero-copy { position: relative; z-index: 1; }
	.hero .lead { margin: 28px 0 0; }
	.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 34px; }
	.actions a { display: inline-flex; align-items: center; gap: 12px; padding: 12px 18px; border-radius: 10px; font-weight: 700; text-decoration: none; }
	.primary { color: white; background: var(--ink); }
	.primary:hover { background: var(--blue); }
	.secondary { color: var(--ink); border: 1px solid var(--line); background: rgba(255,255,255,.35); }
	.portrait-wrap { position: relative; }
	.portrait-wrap::before { content: ""; position: absolute; inset: -18px 24px 38px -20px; border: 1px solid var(--line); border-radius: 44% 44% 18px 18px; transform: rotate(-4deg); }
	.portrait-wrap img { position: relative; width: 100%; border-radius: 44% 44% 16px 16px; box-shadow: 0 30px 80px rgba(23,36,58,.14); }
	.portrait-note { position: relative; margin-top: 16px; display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .78rem; }
	.portrait-note span { width: 7px; height: 7px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 5px rgba(202,92,39,.12); }
	.principle { margin-bottom: 96px; padding: clamp(38px, 7vw, 74px); border-radius: 24px; color: var(--white); background: var(--ink); }
	.principle .eyebrow { color: #9fbee6; }
	.principle > p:last-child { max-width: 850px; margin: 0; font-family: Georgia, "Noto Serif SC", serif; font-size: clamp(1.6rem, 4vw, 3.2rem); line-height: 1.4; }
	@media (max-width: 800px) { .hero { min-height: auto; grid-template-columns: 1fr; padding-top: 56px; } .portrait-wrap { width: min(72vw, 390px); } }
</style>
